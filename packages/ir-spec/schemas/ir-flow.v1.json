{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://work-graph.dev/schemas/ir-flow.v1.json",
  "title": "IR Flow v1",
  "type": "object",
  "required": ["schema", "nodes", "edges"],
  "properties": {
    "schema": { "const": "ir.flow.v1" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["decision", "action", "merge", "start", "end"] },
          "basis": { "type": "string" },
          "vector": { "type": "string" },
          "goal": { "type": "string" },
          "domain": { "type": "string" },
          "stepVersion": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "condition": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
