{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://work-graph.dev/schemas/pvrg.v1.json",
  "title": "PVRG v1",
  "type": "object",
  "required": ["schema", "nodes", "edges"],
  "properties": {
    "schema": { "const": "pvrg.v1" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string" },
          "kind": {
            "type": "string",
            "description": "file | function | work_item | bvc_atom | test | evidence | ..."
          },
          "path": { "type": "string" },
          "label": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "kind": { "type": "string" },
          "verified": { "type": "boolean" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
